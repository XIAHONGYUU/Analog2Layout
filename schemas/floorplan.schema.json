{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/Analog2Layout/floorplan.schema.json",
  "title": "Analog2Layout floorplan intent",
  "description": "A floorplan sketch intent in micrometres, origin top-left, y down. This is not a legal layout.",
  "type": "object",
  "required": [
    "design",
    "units",
    "canvas",
    "symmetry_axis_x",
    "groups",
    "devices",
    "ports",
    "reserve",
    "stats"
  ],
  "properties": {
    "design": {
      "type": "string"
    },
    "rules": {
      "type": "string"
    },
    "units": {
      "const": "um"
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "symmetry_axis_x": {
      "type": "number"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "role",
          "band",
          "x",
          "y",
          "w",
          "h",
          "devices"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "band": {
            "type": "string",
            "enum": [
              "top",
              "mid",
              "bottom",
              "periphery"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number",
            "minimum": 0
          },
          "h": {
            "type": "number",
            "minimum": 0
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "symmetry": {
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "x",
          "y",
          "w",
          "h",
          "proposed"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "match": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "mos",
              "cap",
              "dummy"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "area_um2": {
            "type": "number",
            "minimum": 0
          },
          "proposed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          },
          "fold": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "x",
          "y",
          "side"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "net": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "side": {
            "type": "string",
            "enum": [
              "top",
              "bottom",
              "left",
              "right",
              "pin-top",
              "pin-right"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "orientation",
          "x1",
          "y1",
          "x2",
          "y2"
        ],
        "properties": {
          "orientation": {
            "type": "string",
            "enum": [
              "horizontal",
              "vertical"
            ]
          },
          "x1": {
            "type": "number"
          },
          "y1": {
            "type": "number"
          },
          "x2": {
            "type": "number"
          },
          "y2": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "y0",
          "y1"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "y0": {
            "type": "number"
          },
          "y1": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "reserve": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "stats": {
      "type": "object",
      "properties": {
        "group_count": {
          "type": "integer",
          "minimum": 0
        },
        "device_count": {
          "type": "integer",
          "minimum": 0
        },
        "proposed_dummy_count": {
          "type": "integer",
          "minimum": 0
        },
        "device_area_um2": {
          "type": "number",
          "minimum": 0
        },
        "core_area_um2": {
          "type": "number",
          "minimum": 0
        },
        "floorplan_area_um2": {
          "type": "number",
          "minimum": 0
        },
        "utilization": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "core_utilization": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "whitespace_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "block_width_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "block_height_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "aspect_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "squareness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "orientation": {
          "type": "string",
          "enum": [
            "landscape",
            "portrait",
            "square-ish"
          ]
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "groups_by_band": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "arrangement": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
